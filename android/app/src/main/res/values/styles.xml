<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <!-- 窗口背景直接用背景图：这样连同手势条/导航栏区域一起铺满，
             不会像 ImageView 那样被内容区高度卡住留一条黑 -->
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:statusBarColor">#0b0d12</item>
        <item name="android:navigationBarColor">#0b0d12</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">#4CC2FF</item>
    </style>

    <!-- 跟 App 一个色系的弹窗：系统默认是 Material 灰底，跟深蓝背景不搭 -->
    <style name="DarkDialog" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:background">#12151c</item>
        <item name="android:colorAccent">#4CC2FF</item>
        <item name="android:textColorPrimary">#e8ebf2</item>
        <item name="android:textColorSecondary">#8b93a7</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0b0d12"
    android:paddingHorizontal="16dp">

    <!-- 顶部：标题 + 副标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XFlow"
            android:textColor="#5CC9FF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:id="@+id/subText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="汐流 · 把文件带下来"
                android:textColor="#8b93a7"
                android:textSize="11.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 输入区 -->
    <EditText
        android:id="@+id/urlEdit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hint="粘贴链接（直链 / 磁力 / .torrent）"
        android:textColorHint="#5b6478"
        android:textColor="#e8ebf2"
        android:textSize="14sp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="14dp"
        android:inputType="textUri"
        android:singleLine="true" />

    <EditText
        android:id="@+id/nameEdit"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="9dp"
        android:hint="文件名（可留空）"
        android:textColorHint="#5b6478"
        android:textColor="#e8ebf2"
        android:textSize="14sp"
        android:background="@drawable/input_bg"
        android:paddingHorizontal="14dp"
        android:inputType="text"
        android:singleLine="true" />

    <Button
        android:id="@+id/addBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="开始下载"
        android:textColor="#04121c"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:background="@drawable/btn_bg"
        android:stateListAnimator="@null" />

    <Button
        android:id="@+id/torrentBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="9dp"
        android:text="选种子文件（.torrent）"
        android:textColor="#c9d2e3"
        android:textSize="13.5sp"
        android:background="@drawable/btn_small_bg"
        android:stateListAnimator="@null" />

    <!-- 任务区标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="任务"
            android:textColor="#e8ebf2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#8b93a7"
            android:textSize="11.5sp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/jobList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>

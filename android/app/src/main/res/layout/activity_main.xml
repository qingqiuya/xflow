<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 顶部品牌条 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="XFlow"
            android:textColor="#5CC9FF"
            android:textSize="27sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="11dp">

            <TextView
                android:id="@+id/subText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="汐流 · 把文件带下来"
                android:textColor="#8b93a7"
                android:textSize="11.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/shareChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="互传"
            android:textColor="#5b6478"
            android:textSize="11sp"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="7dp" />

        <TextView
            android:id="@+id/biliChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="B站"
            android:textColor="#5b6478"
            android:textSize="11sp"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="7dp" />

        <TextView
            android:id="@+id/apiChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="API"
            android:textColor="#5b6478"
            android:textSize="11sp"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="7dp" />

        <TextView
            android:id="@+id/verText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.6.31"
            android:textColor="#8b93a7"
            android:textSize="11sp"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <!-- 页签：下载 / 互传（左右滑也能切） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="18dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tabDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="下载"
            android:textColor="#e8ebf2"
            android:textSize="15sp"
            android:textStyle="bold"
            android:paddingVertical="6dp" />

        <TextView
            android:id="@+id/tabShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="互传"
            android:textColor="#6b7385"
            android:textSize="15sp"
            android:paddingVertical="6dp"
            android:layout_marginStart="20dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <LinearLayout
        android:id="@+id/pageDownload"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

    <!-- 输入卡片 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:background="@drawable/input_row_bg"
        android:padding="6dp">

        <EditText
            android:id="@+id/urlEdit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="粘贴链接或 BV 号（直链 / 磁力 / B站 / .torrent）"
            android:textColorHint="#5b6478"
            android:textColor="#e8ebf2"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:paddingHorizontal="12dp"
            android:inputType="textUri"
            android:singleLine="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="12dp"
            android:background="#1c222e" />

        <EditText
            android:id="@+id/nameEdit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="文件名（可留空，按链接自动取）"
            android:textColorHint="#5b6478"
            android:textColor="#e8ebf2"
            android:textSize="14sp"
            android:background="@android:color/transparent"
            android:paddingHorizontal="12dp"
            android:inputType="text"
            android:singleLine="true" />
    </LinearLayout>

    <!-- 按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="10dp">

        <Button
            android:id="@+id/addBtn"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:text="开始下载"
            android:textColor="#04121c"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:background="@drawable/btn_bg"
            android:stateListAnimator="@null" />

        <Button
            android:id="@+id/torrentBtn"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:layout_marginStart="8dp"
            android:text="上传种子文件"
            android:textColor="#c9d2e3"
            android:textSize="13sp"
            android:background="@drawable/btn_small_bg"
            android:stateListAnimator="@null"
            android:paddingHorizontal="14dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp" />
    </LinearLayout>

    <!-- 任务区头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginHorizontal="18dp"
        android:layout_marginTop="22dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="任务"
            android:textColor="#e8ebf2"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/statText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="#8b93a7"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/clearBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清空历史"
            android:textColor="#8b93a7"
            android:textSize="11.5sp"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/jobScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:scrollbars="none">

        <!-- ScrollView 只能有一个直接子 View，所以外面再包一层 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/jobList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/peerList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="14dp" />
        </LinearLayout>
    </ScrollView>
    </LinearLayout><!-- /pageDownload -->

    <ScrollView
        android:id="@+id/pageShare"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/share_panel" />
        </FrameLayout>
    </ScrollView>
    </FrameLayout><!-- /pager -->
    </LinearLayout>
</FrameLayout>

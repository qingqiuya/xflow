<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0f1115"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="XFlow"
        android:textColor="#4cc2ff"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/subText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="汐流 · 把文件带下来"
        android:textColor="#8b93a7"
        android:textSize="12sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/urlEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="粘贴链接（直链 / 磁力 / .torrent）"
        android:textColorHint="#5b6478"
        android:textColor="#e8ebf2"
        android:background="@drawable/input_bg"
        android:padding="12dp"
        android:inputType="textUri"
        android:singleLine="true" />

    <EditText
        android:id="@+id/nameEdit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="文件名（可留空）"
        android:textColorHint="#5b6478"
        android:textColor="#e8ebf2"
        android:background="@drawable/input_bg"
        android:padding="12dp"
        android:inputType="text"
        android:singleLine="true" />

    <Button
        android:id="@+id/addBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="开始下载"
        android:textColor="#04121c"
        android:background="@drawable/btn_bg" />

    <Button
        android:id="@+id/torrentBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="选种子文件（.torrent）"
        android:textColor="#c9d2e3"
        android:textSize="13sp"
        android:background="@drawable/btn_small_bg" />

    <TextView
        android:id="@+id/statText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text=""
        android:textColor="#8b93a7"
        android:textSize="12sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:id="@+id/jobList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>

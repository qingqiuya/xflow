<?xml version="1.0" encoding="utf-8"?>
<!-- B 站登录：统一深色卡片，扫码 / 账号两个 tab 在同一个壳里切（不显示 B 站页面） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_bg"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="登录 B 站"
            android:textColor="#e8ebf2"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/biliLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="退出"
            android:textColor="#8b93a7"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="登录后下载请求会带上 Cookie，480P 提到 720P / 1080P"
        android:textColor="#8b93a7"
        android:textSize="11.5sp" />

    <!-- tab -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tabQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="扫码"
            android:textColor="#4CC2FF"
            android:textSize="12sp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/tabAcc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/chip_bg"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:text="账号"
            android:textColor="#6b7488"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 扫码页 -->
    <LinearLayout
        android:id="@+id/pageQr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/qrTip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在生成二维码…"
            android:textColor="#8b93a7"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/qrImage"
            android:layout_width="216dp"
            android:layout_height="216dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/qr_box_bg"
            android:padding="8dp"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/qrSave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_small_bg"
            android:enabled="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="存到相册，用 B 站 App 选图扫"
            android:textColor="#cfd6e4"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="同一部手机扫不了自己屏幕——\n存相册后：B 站 → 扫一扫 → 右上角相册"
            android:textColor="#5b6478"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- 账号页（自己的表单，不加载 B 站页面） -->
    <LinearLayout
        android:id="@+id/pageAcc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modePwd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="密码登录"
                android:textColor="#4CC2FF"
                android:textSize="12sp"
                android:layout_marginEnd="16dp" />

            <TextView
                android:id="@+id/modeSms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="短信登录"
                android:textColor="#6b7488"
                android:textSize="12sp" />
        </LinearLayout>

        <EditText
            android:id="@+id/accPhone"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/input_bg"
            android:hint="手机号"
            android:inputType="phone"
            android:maxLength="11"
            android:paddingHorizontal="12dp"
            android:textColor="#e8ebf2"
            android:textColorHint="#5b6478"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/accPwd"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/input_bg"
            android:hint="密码"
            android:inputType="textPassword"
            android:paddingHorizontal="12dp"
            android:textColor="#e8ebf2"
            android:textColorHint="#5b6478"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/smsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/accCode"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:hint="短信验证码"
                android:inputType="number"
                android:maxLength="6"
                android:paddingHorizontal="12dp"
                android:textColor="#e8ebf2"
                android:textColorHint="#5b6478"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnSendCode"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/btn_small_bg"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="获取验证码"
                android:textColor="#cfd6e4"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/accTip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="密码登录需要过一次极验滑块"
            android:textColor="#5b6478"
            android:textSize="10.5sp" />

        <TextView
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/primary"
            android:gravity="center"
            android:text="登录"
            android:textColor="#0b0f17"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/biliRowClose"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="end"
        android:paddingVertical="6dp"
        android:text="关闭"
        android:textColor="#4CC2FF"
        android:textSize="13sp" />
</LinearLayout>

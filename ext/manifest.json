{
  "manifest_version": 3,
  "name": "汐流下载器 · 接管浏览器下载",
  "version": "1.1.8",
  "description": "把浏览器的下载转给本机运行的汐流（XFlow）下载器：多线程、断点续传、BT。",
  "permissions": [
    "downloads",
    "cookies",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "汐流下载器"
  },
  "icons": {
    "128": "icon128.png"
  }
}
